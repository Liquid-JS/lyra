{
  "extends": [
    "@commitlint/config-conventional"
  ],
  "plugins": [
    "@liquid-js/commitlint-plugin-workspace-scopes"
  ],
  "rules": {
    "scope-enum": [
      2,
      "always",
      {
        "stripPrefix": [
          "@liquid-js/lyr-"
        ]
      }
    ],
    "body-max-line-length": [
      0
    ]
  }
}
