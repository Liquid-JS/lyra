        "playground": {
            "projectType": "application",
            "root": "packages/playground",
            "sourceRoot": "packages/playground/src",
            "prefix": "npg",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "changeDetection": "OnPush"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": {
                            "base": "dist/playground",
                            "browser": ""
                        },
                        "browser": "packages/playground/src/main.ts",
                        "index": "packages/playground/src/index.html",
                        "polyfills": [],
                        "tsConfig": "packages/playground/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "allowedCommonJsDependencies": [
                            "extend",
                            "format",
                            "highlight.js"
                        ],
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "packages/playground/public"
                            },
                            {
                                "glob": "*.svg",
                                "input": "node_modules/nxt-flags/assets/flags",
                                "output": "assets/flags"
                            }
                        ],
                        "styles": [
                            {
                                "input": "packages/playground/src/playground/styles/styles.scss",
                                "bundleName": "playground-theme",
                                "inject": false
                            }
                        ],
                        "stylePreprocessorOptions": {
                            "includePaths": [
                                "node_modules/.lyra-styles"
                            ]
                        }
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2MB",
                                    "maximumError": "10MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "48kB",
                                    "maximumError": "2MB"
                                }
                            ],
                            "optimization": {
                                "scripts": true,
                                "styles": {
                                    "minify": true,
                                    "inlineCritical": true
                                },
                                "fonts": false
                            },
                            "outputHashing": "all"
                        },
                        "production-wp": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2MB",
                                    "maximumError": "10MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "48kB",
                                    "maximumError": "2MB"
                                }
                            ],
                            "optimization": {
                                "scripts": true,
                                "styles": {
                                    "minify": true,
                                    "inlineCritical": true
                                },
                                "fonts": false
                            },
                            "outputHashing": "all",
                            "tsConfig": "packages/playground/tsconfig.wp.json"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "namedChunks": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "playground:build:production"
                        },
                        "production-wp": {
                            "buildTarget": "playground:build:production-wp"
                        },
                        "development": {
                            "buildTarget": "playground:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n"
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "packages/playground/**/*.ts",
                            "packages/playground/**/*.js",
                            "packages/playground/**/*.cjs",
                            "packages/playground/**/*.html"
                        ],
                        "eslintConfig": "packages/playground/eslint.config.js"
                    }
                }
            }
        },
        "docs": {
            "projectType": "application",
            "root": "packages/docs",
            "sourceRoot": "packages/docs/src",
            "prefix": "ngd",
            "schematics": {
