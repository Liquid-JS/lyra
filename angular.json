{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "yarn",
        "schematicCollections": [
            "angular-eslint"
        ],
        "analytics": false
    },
    "schematics": {
        "@schematics/angular:component": {
            "viewEncapsulation": "Emulated",
            "style": "scss",
            "type": "component"
        },
        "@schematics/angular:service": {
            "type": "service"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    },
    "newProjectRoot": "packages",
    "projects": {
        "core": {
            "projectType": "library",
            "root": "packages/core",
            "sourceRoot": "packages/core/src",
            "prefix": "nb",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "changeDetection": "OnPush"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "packages/core/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "packages/core/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "buildTarget": "core:test-build",
                        "tsConfig": "packages/core/tsconfig.spec.json",
                        "runner": "vitest",
                        "runnerConfig": true,
                        "browsers": [
                            "chromium"
                        ],
                        "headless": true,
                        "browserViewport": "1024x768",
                        "setupFiles": [
                            "packages/test-setup.ts"
                        ]
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "packages/core/**/*.ts",
                            "packages/core/**/*.js",
                            "packages/core/**/*.cjs",
                            "packages/core/**/*.html"
                        ],
                        "eslintConfig": "packages/core/eslint.config.js"
                    }
                },
                "test-build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "tsConfig": "packages/core/tsconfig.spec.json",
                        "polyfills": [],
                        "stylePreprocessorOptions": {
                            "includePaths": [
                                "node_modules/.lyra-styles"
                            ]
                        },
                        "aot": false
                    }
                }
            }
        },
        "icons": {
            "projectType": "library",
            "root": "packages/icons",
            "sourceRoot": "packages/icons/src",
            "prefix": "nb",
            "schematics": {
                "@schematics/angular:component": {
