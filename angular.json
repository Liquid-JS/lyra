                            "packages/docs/src/app/@theme/styles/highlight-dracula.css",
                            "packages/docs/src/app/@theme/styles/styles.scss",
                            {
                                "input": "packages/playground/src/playground/styles/styles.scss",
                                "bundleName": "playground-theme",
                                "inject": false
                            }
                        ],
                        "allowedCommonJsDependencies": [
