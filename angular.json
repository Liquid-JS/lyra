                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "packages/icons/**/*.ts",
                            "packages/icons/**/*.js",
                            "packages/icons/**/*.cjs",
                            "packages/icons/**/*.html"
                        ],
                        "eslintConfig": "packages/icons/eslint.config.js"
                    }
                }
            }
        },
