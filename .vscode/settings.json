{
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "files.autoSave": "off",
    "html.format.wrapAttributes": "force",
    "html.format.wrapLineLength": 0,
    "html.format.maxPreserveNewLines": 1,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": false,
    "typescript.tsdk": "node_modules/typescript/lib",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/.angular": true,
        "**/dist": true
    },
    "[yaml]": {
        "editor.tabSize": 2
    },
    "[toml]": {
        "editor.tabSize": 2
    },
    // Templates use VS Code's built-in HTML formatter; js-beautify.json holds the same options for `yarn lint:html`.
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    // Markdown uses remark's extension, with `.remarkrc.mjs`, the settings of `yarn format:md`.
    "[markdown]": {
        "editor.defaultFormatter": "unifiedjs.vscode-remark"
    },
    "eslint.validate": [
        "javascript",
        "typescript",
        "html"
    ],
    "stylelint.validate": [
        "css",
        "less",
        "postcss",
        "scss"
    ],
    // disable error duplication for scss files
    "scss.validate": false
}
