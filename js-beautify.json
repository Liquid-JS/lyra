{
  "html": {
    "wrap_attributes": "force",
    "wrap_line_length": 0,
    "templating": ["none"],
    "unformatted": ["wbr"],
    "content_unformatted": ["pre", "code", "textarea"],
    "indent_handlebars": false
  },
  "indent_size": 2,
  "end_with_newline": true,
  "max_preserve_newlines": 1
}
