{
    "name": "lyra",
    "description": "Lyra: customizable Angular UI components and theming",
    "version": "0.0.0",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Liquid-JS/lyra.git"
    },
    "bugs": {
        "url": "https://github.com/Liquid-JS/lyra/issues"
    },
    "homepage": "https://github.com/Liquid-JS/lyra#readme",
    "author": "HitkoDev <development@hitko.si>",
    "license": "MIT",
    "type": "module",
    "keywords": [
        "angular",
        "typescript",
        "lyra",
        "ui",
        "components"
    ],
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "postinstall": "husky && node scripts/link-styles.ts",
        "start": "yarn build:dev-schematics && yarn gen:playground && yarn workspace playground serve",
        "start:wp": "yarn build:dev-schematics && yarn gen:playground && yarn workspace playground serve --configuration production-wp",
        "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
        "build": "yarn workspace @liquid-js/lyr-core build && yarn workspace @liquid-js/lyr-auth build && yarn workspaces foreach -vipA -j unlimited --exclude @liquid-js/lyr-core --exclude @liquid-js/lyr-auth --exclude playground --exclude docs run build && yarn build:schematics && yarn build:sass",
        "build:schematics": "tsc -p packages/core/tsconfig.schematics.json",
        "build:sass": "sass dist/auth/styles/prebuilt dist/core/styles/prebuilt --load-path=node_modules/.lyra-styles --load-path=node_modules --style=compressed --no-source-map",
        "build:dev-schematics": "node scripts/build-dev-schematics.ts",
        "build:playground": "yarn workspace playground build",
        "build:playground:wp": "yarn workspace playground build --configuration production-wp",
        "watch": "yarn workspaces foreach -vipA -j unlimited --exclude playground --exclude docs run watch",
        "test": "yarn workspaces foreach -vA --exclude playground --exclude docs run test",
        "test:watch": "yarn workspace @liquid-js/lyr-core test:watch",
        "test:schematics": "tsc -p packages/core/tsconfig.schematics.spec.json && vitest run --dir dist/core/schematics --globals --environment node",
        "e2e": "playwright test",
        "e2e:install": "playwright install --with-deps chromium firefox webkit",
        "e2e:safari": "playwright test -c playwright.safari.config.ts",
        "lint": "yarn constraints && node scripts/check-versions.ts && node scripts/check-theme-references.ts && node scripts/icons.ts --check && node scripts/essential-icons.ts --check && node scripts/core-entry-points.ts --check && node scripts/format-md.ts --check && node scripts/check-spec-templates.ts && eslint . && yarn workspaces foreach -vipA -j unlimited run lint",
        "lint:fix": "eslint . --fix && yarn workspaces foreach -vipA -j unlimited run lint:fix",
        "lint:html": "yarn workspaces foreach -vipA -j unlimited run lint:html",
        "lint:sass": "yarn workspaces foreach -vipA -j unlimited run lint:sass",
        "lint:sass:fix": "yarn workspaces foreach -vipA -j unlimited run lint:sass:fix",
        "format:md": "node scripts/format-md.ts",
        "icons": "node scripts/icons.ts && node scripts/essential-icons.ts",
        "gen:playground": "ng g .:playground",
        "gen:playground-module": "ng g .:playground-module",
        "gen:playground-components": "ng g .:playground-components",
        "design-kit:tokens": "yarn workspace design-kit tokens",
        "design-kit:capture": "yarn workspace design-kit capture",
        "design-kit:model": "yarn workspace design-kit model",
        "design-kit:sketch": "yarn workspace design-kit sketch",
        "design-kit:manifest": "yarn workspace design-kit manifest",
        "design-kit:devices": "yarn workspace design-kit devices",
        "docs:prepare": "node scripts/docs/prepare.ts",
        "docs:example-pictures": "node scripts/docs/example-pictures.ts",
        "docs:home-devices": "node scripts/docs/home-devices.ts",
        "docs:serve": "yarn docs:prepare && yarn workspace docs serve --port 4100",
        "docs:build": "yarn docs:prepare && yarn workspace docs build --configuration production-wp --base-href /lyra/ && node scripts/docs/postbuild.ts",
        "docs:publish": "yarn docs:build && angular-cli-ghpages --dir=dist/docs --no-notfound --no-silent",
        "release": "lerna version --sync-workspace-lock",
        "publish": "node scripts/publish.ts"
    },
    "devDependencies": {
        "@angular-devkit/core": "^22.3.0",
        "@angular-devkit/schematics": "^22.3.0",
        "@angular/build": "^22.3.0",
        "@angular/cdk": "^22.3.0",
        "@angular/cli": "^22.3.0",
        "@angular/common": "^22.3.0",
        "@angular/compiler": "^22.3.0",
        "@angular/compiler-cli": "^22.3.0",
        "@angular/core": "^22.3.0",
        "@angular/fire": "^22.0.0-rc.1",
        "@angular/forms": "^22.3.0",
        "@angular/language-service": "^22.3.0",
        "@angular/localize": "^22.3.0",
        "@angular/platform-browser": "^22.3.0",
        "@angular/platform-server": "^22.3.0",
        "@angular/router": "^22.3.0",
        "@angular/service-worker": "^22.3.0",
        "@angular/ssr": "^22.3.0",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@lerna-lite/cli": "^5.9.0",
        "@lerna-lite/version": "^5.9.0",
        "@liquid-js/angular-cli-ghpages": "^2.0.4",
        "@liquid-js/commitlint-plugin-workspace-scopes": "^2.1.1",
        "@liquid-js/lyr-auth": "workspace:*",
        "@liquid-js/lyr-core": "workspace:*",
        "@liquid-js/qr-code-styling": "^5.7.0-3",
        "@liquid-js/qrcode-generator": "^1.1.7",
        "@liquid-js/underflow": "^4.0.0",
        "@playwright/test": "^1.65.1",
        "@schematics/angular": "^22.3.0",
        "@stylistic/eslint-plugin": "^6.0.1",
        "@stylistic/stylelint-config": "^6.1.0",
        "@types/mdast": "^4.0.4",
        "@types/node": "^26.0.0",
        "@types/sortablejs": "^1.15.9",
        "@videojs/core": "^10.6.0",
        "@videojs/hlsjs-video": "^10.6.0",
        "@videojs/media": "^10.6.0",
        "@videojs/store": "^10.6.0",
        "@vitest/browser-playwright": "^5.1.1",
        "@yarnpkg/types": "^4.0.1",
        "angular-eslint": "^22.8.0",
        "chart.js": "^4.6.1",
        "cross-env": "^10.1.0",
        "date-fns": "^4.4.0",
        "dompurify": "^3.4.18",
        "eslint": "^10.15.0",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-jsdoc": "^65.5.1",
        "eslint-plugin-prefer-arrow-functions": "^3.10.2",
        "eslint-plugin-rxjs-x": "^1.0.6",
        "eslint-plugin-unused-imports": "^4.4.1",
        "firebase": "^13.4.0",
        "globals": "^17.14.0",
        "highlight.js": "^11.12.0",
        "husky": "^9.1.7",
        "i18n-iso-countries": "^7.14.0",
        "js-beautify": "^2.0.3",
        "libphonenumber-js": "^1.13.17",
        "lint-staged": "^17.6.1",
        "maska": "^3.2.2",
        "moment": "^2.31.0",
        "ng-packagr": "^22.3.0",
        "ngx-remark": "^0.2.2",
        "npm-check-updates": "^23.1.1",
        "nxt-color-picker": "^22.2.1",
        "nxt-flags": "^22.2.0",
        "nxt-highlightjs": "^22.1.0",
        "nxt-sortablejs": "^22.0.0",
        "playwright": "^1.65.1",
        "postcss": "^8.5.33",
        "prosemirror-commands": "^1.7.2",
        "prosemirror-history": "^1.5.2",
        "prosemirror-inputrules": "^1.7.0",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.13",
        "prosemirror-state": "^1.4.4",
        "prosemirror-transform": "^1.12.7",
        "prosemirror-view": "^1.43.0",
        "remark": "^15.0.1",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-smartypants": "^3.0.3",
        "rxjs": "^7.8.2",
        "sass": "^1.108.2",
        "sortablejs": "^1.15.7",
        "stylelint": "^18.1.0",
        "stylelint-config-standard-scss": "^18.0.0",
        "tslib": "^2.9.1",
        "typescript": ">=6.0 <6.1",
        "typescript-eslint": "^8.73.0",
        "unified": "^11.0.5",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "packageManager": "yarn@4.19.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "resolutions": {
        "@liquid-js/angular-cli-ghpages/@angular-devkit/architect": "^0.2203.0",
        "@liquid-js/angular-cli-ghpages/@angular-devkit/core": "^22.3.0",
        "@liquid-js/angular-cli-ghpages/@angular-devkit/schematics": "^22.3.0",
        "ng-packagr/sass": "^1.107.1",
        "ng-packagr/sass-embedded": "^1.107.1",
        "@angular/build/sass": "^1.107.1",
        "@angular/build/sass-embedded": "^1.107.1",
        "@types/node": "^26.0.0"
    },
    "schematics": "./tools/dev-schematics/dist/collection.json",
    "lint-staged": {
        "*.{ts,js,mjs,cjs}": "eslint --cache --fix",
        "*.{scss,css}": "stylelint --fix",
        "*.html": "js-beautify --type html -r --config js-beautify.json",
        "*.md": "node scripts/format-md.ts"
    }
}
