{
  "name": "@liquid-js/lyr-date-fns",
  "version": "22.0.0",
  "type": "module",
  "description": "date-fns date adapter for Lyra",
  "author": "HitkoDev <development@hitko.si>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liquid-JS/lyra.git"
  },
  "bugs": {
    "url": "https://github.com/Liquid-JS/lyra/issues"
  },
  "homepage": "https://github.com/Liquid-JS/lyra/tree/master/packages/date-fns#readme",
  "keywords": [
    "angular",
    "typescript",
