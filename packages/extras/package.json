{
    "name": "@liquid-js/lyr-extras",
    "description": "Lyra components built on other libraries: QR codes, charts, markdown editor and viewer, colour picker, phone input, input masks, video and audio",
    "bugs": {
        "url": "https://github.com/Liquid-JS/lyra/issues"
    },
    "version": "22.0.0",
    "license": "MIT",
    "author": "HitkoDev <development@hitko.si>",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Liquid-JS/lyra.git"
    },
    "homepage": "https://github.com/Liquid-JS/lyra/tree/master/packages/extras#readme",
    "keywords": [
        "angular",
        "typescript",
        "lyra",
        "ui",
        "components",
        "qr-code",
        "markdown",
        "phone-input",
        "mask",
        "color-picker",
        "chart"
    ],
    "scripts": {
        "watch": "run -T ng build extras --configuration development --watch",
        "build": "run -T ng build extras --configuration production",
        "lint": "run -T ng lint extras",
        "lint:fix": "yarn lint --fix",
        "lint:html": "run -T js-beautify --type html -r -f ./*/src/**/*.html --config ./js-beautify.json",
        "lint:sass": "run -T stylelint \"**/*.scss\"",
        "lint:sass:fix": "yarn lint:sass --fix",
        "test": "run -T ng test extras --no-watch",
        "test:watch": "run -T ng test extras"
    },
    "peerDependencies": {
        "@angular/common": "^22.0.0",
        "@angular/core": "^22.0.0",
        "@angular/forms": "^22.0.0",
        "@angular/platform-browser": "^22.0.0",
        "@liquid-js/lyr-core": "^22.0.0",
        "@liquid-js/qr-code-styling": "^5.7.0-3",
        "@liquid-js/qrcode-generator": "^1.1.7",
        "@liquid-js/underflow": "^4.0.0-14",
        "@videojs/core": "~10.5.0",
        "@videojs/media": "~10.5.0",
        "@videojs/store": "~10.5.0",
        "chart.js": "^4.6.1",
        "highlight.js": "^11.11.1",
        "i18n-iso-countries": "^7.14.0",
        "libphonenumber-js": "^1.13.15",
        "maska": "^3.2.2",
        "ngx-remark": "^0.2.2",
        "nxt-color-picker": "^22.2.1",
        "nxt-flags": "^22.2.0",
        "nxt-highlightjs": "^22.1.0",
        "remark": "^15.0.1",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-smartypants": "^3.0.3",
        "rxjs": "^6.5.3 || ^7.4.0",
        "tslib": "^2.9.1"
    },
    "peerDependenciesMeta": {
        "@liquid-js/qr-code-styling": {
            "optional": true
        },
        "@liquid-js/qrcode-generator": {
            "optional": true
        },
        "@liquid-js/underflow": {
            "optional": true
        },
        "@videojs/core": {
            "optional": true
        },
        "@videojs/media": {
            "optional": true
        },
        "@videojs/store": {
            "optional": true
        },
        "chart.js": {
            "optional": true
        },
        "highlight.js": {
            "optional": true
        },
        "i18n-iso-countries": {
            "optional": true
        },
        "libphonenumber-js": {
            "optional": true
        },
        "maska": {
            "optional": true
        },
        "ngx-remark": {
            "optional": true
        },
        "nxt-color-picker": {
            "optional": true
        },
        "nxt-flags": {
            "optional": true
        },
        "nxt-highlightjs": {
            "optional": true
        },
        "remark": {
            "optional": true
        },
        "remark-frontmatter": {
            "optional": true
        },
        "remark-gfm": {
            "optional": true
        },
        "remark-smartypants": {
            "optional": true
        }
    },
    "sideEffects": false
}
