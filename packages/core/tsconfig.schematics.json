{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "schematics",
    "outDir": "../../dist/core/schematics",
    "types": [
      "node"
    ]
  },
  "include": [
    "schematics/**/*"
  ],
  "exclude": [
    "schematics/*/files/**/*",
    "schematics/**/*.spec.ts"
  ]
}
