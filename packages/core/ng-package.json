{
    "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
    "dest": "../../dist/core",
    "lib": {
        "entryFile": "src/public-api.ts"
    },
    "assets": [
        "LICENSE.txt",
        {
            "input": "src",
            "glob": "**/*.{html,scss}",
            "ignore": ["**/*.spec.*"],
            "output": "."
        },
        "schematics/collection.json",
        "schematics/*/schema.json",
        "schematics/*/files/**"
    ]
}
