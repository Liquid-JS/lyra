{
    "name": "@liquid-js/lyr-core",
    "description": "Customizable Angular UI components and theming",
    "bugs": {
        "url": "https://github.com/Liquid-JS/lyra/issues"
    },
    "version": "22.0.0-alpha.9",
    "license": "MIT",
    "author": "HitkoDev <development@hitko.si>",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Liquid-JS/lyra.git"
    },
    "homepage": "https://github.com/Liquid-JS/lyra/tree/master/packages/core#readme",
    "keywords": [
        "angular",
        "typescript",
        "lyra",
        "ui",
        "components",
        "theme"
    ],
    "scripts": {
        "watch": "run -T ng build core --configuration development --watch",
        "build": "run -T ng build core --configuration production",
        "lint": "run -T ng lint core",
        "lint:fix": "yarn lint --fix",
        "lint:html": "run -T js-beautify --type html -r -f ./src/**/*.html --config ./js-beautify.json",
        "lint:sass": "run -T stylelint \"src/**/*.scss\"",
        "lint:sass:fix": "yarn lint:sass --fix",
        "test": "run -T ng test core --no-watch",
        "test:watch": "run -T ng test core"
    },
    "peerDependencies": {
        "@angular/cdk": "^22.0.0",
        "@angular/common": "^22.0.0",
        "@angular/core": "^22.0.0",
        "@angular/forms": "^22.0.0",
        "@angular/localize": "^22.0.0",
        "@angular/platform-browser": "^22.0.0",
        "@angular/router": "^22.0.0",
        "rxjs": "^6.5.3 || ^7.4.0",
        "tslib": "^2.9.1"
    },
    "peerDependenciesMeta": {
        "@angular/localize": {
            "optional": true
        }
    },
    "schematics": "./schematics/collection.json",
    "sideEffects": false,
    "exports": {
        "./styles/core/mixins": {
            "sass": "./styles/core/_mixins.scss"
        },
        "./styles/core/variants": {
            "sass": "./styles/core/_variants.scss"
        },
        "./styles/global/typography/typography": {
            "sass": "./styles/global/typography/_typography.scss"
        },
        "./styles/global/breakpoints": {
            "sass": "./styles/global/_breakpoints.scss"
        },
        "./styles/prebuilt/corporate.css": {
            "style": "./styles/prebuilt/corporate.css"
        },
        "./styles/prebuilt/cosmic.css": {
            "style": "./styles/prebuilt/cosmic.css"
        },
        "./styles/prebuilt/dark.css": {
            "style": "./styles/prebuilt/dark.css"
        },
        "./styles/prebuilt/default.css": {
            "style": "./styles/prebuilt/default.css"
        },
        "./styles/prebuilt/material-dark.css": {
            "style": "./styles/prebuilt/material-dark.css"
        },
        "./styles/prebuilt/material-light.css": {
            "style": "./styles/prebuilt/material-light.css"
        },
        "./styles/themes/corporate": {
            "sass": "./styles/themes/_corporate.scss"
        },
        "./styles/themes/cosmic": {
            "sass": "./styles/themes/_cosmic.scss"
        },
        "./styles/themes/dark": {
            "sass": "./styles/themes/_dark.scss"
        },
        "./styles/themes/default": {
            "sass": "./styles/themes/_default.scss"
        },
        "./styles/themes/mapping": {
            "sass": "./styles/themes/_mapping.scss"
        },
        "./styles/all": {
            "sass": "./styles/_all.scss"
        },
        "./styles/globals": {
            "sass": "./styles/_globals.scss"
        },
        "./styles/themes": {
            "sass": "./styles/_themes.scss"
        },
        "./styles/theming": {
            "sass": "./styles/_theming.scss"
        }
    }
}
